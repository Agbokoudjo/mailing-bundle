{
    "name": "wlindabla/mailing-bundle",
    "description": "Symfony bundle for centralized management of transactional (system) and support/management emails, featuring Twig templates, priority queues, attachments, and DKIM signatures.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "mailer", "email", "mailing", "twig", "dkim", "notifications"],
    "homepage": "https://github.com/Agbokoudjo/wlindabla-mailing-bundle",
    "authors": [
        {
            "name": "AGBOKOUDJO Franck",
            "email": "internationaleswebservices@gmail.com",
            "homepage": "https://github.com/Agbokoudjo/mailing-bundle"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/mime": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bridge": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Wlindabla\\MailingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wlindabla\\MailingBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    }
}
